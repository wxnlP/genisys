<mujoco model="GeniArmTablePickScene">
  <compiler meshdir="../meshes/geniarm_v0.1/" eulerseq="XYZ" fitaabb="true" angle="radian" autolimits="true"/>
  <option timestep="0.001" gravity="0 0 -9.81" iterations="120" solver="Newton" integrator="implicitfast">
    <flag energy="enable"/>
  </option>

  <!-- Module 2: environment and floor style -->
  <include file="module2_environment.xml"/>

  <!-- Module 1: table and table-top objects -->
  <include file="module1_table_objects.xml"/>

  <!-- Module 3: robot body (structure + actuators + sensors) -->
  <include file="module3_geniarm_robot.xml"/>
</mujoco>
