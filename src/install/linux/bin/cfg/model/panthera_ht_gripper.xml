                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <exclude body1="base_link" body2="shoulder_link" />
    <exclude body1="shoulder_link" body2="upper_arm_link" />
    <exclude body1="upper_arm_link" body2="elbow_link" />
    <exclude body1="elbow_link" body2="wrist1_link" />
    <exclude body1="wrist1_link" body2="wrist2_link" />
    <exclude body1="wrist2_link" body2="wrist3_link" />
    <exclude body1="wrist3_link" body2="L_finger" />
    <exclude body1="wrist3_link" body2="R_finger" />
  </contact>

  <equality>
    <joint name="gripper_left_joint_mimic" joint1="gripper_left_joint" joint2="gripper_right_joint" polycoef="0 1 0 0 0" />
  </equality>

  <actuator>
    <motor name="shoulder_actuator"    joint="shoulder_joint"    ctrlrange="-21 21" forcelimited="true" forcerange="-21 21"/>
    <motor name="upper_arm_actuator"  joint="upper_arm_joint"  ctrlrange="-36 36" forcelimited="true" forcerange="-36 36"/>
    <motor name="elbow_actuator"      joint="elbow_joint"      ctrlrange="-36 36" forcelimited="true" forcerange="-36 36"/>
    <motor name="wrist1_actuator"     joint="wrist1_joint"     ctrlrange="-21 21" forcelimited="true" forcerange="-21 21"/>
    <motor name="wrist2_actuator"     joint="wrist2_joint"     ctrlrange="-10 10" forcelimited="true" forcerange="-10 10"/>
    <motor name="wrist3_actuator"     joint="wrist3_joint"     ctrlrange="-10 10" forcelimited="true" forcerange="-10 10"/>
    <motor name="gripper_right_actuator" joint="gripper_right_joint" ctrlrange="-100 100" forcelimited="true" forcerange="-100 100"/>
  </actuator>

  <sensor>
    <jointpos name="jointpos_shoulder" joint="shoulder_joint" noise="0.0002"/>
    <jointvel name="jointvel_shoulder" joint="shoulder_joint" noise="0.002"/>
    <jointactuatorfrc name="jointactuatorfrc_shoulder" joint="shoulder_joint" noise="0.02"/>

    <jointpos name="jointpos_upper_arm" joint="upper_arm_joint" noise="0.0002"/>
