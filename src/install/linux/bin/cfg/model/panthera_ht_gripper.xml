                </body>
                <body name="R_finger" pos="0.165 0 0">
                  <inertial pos="-0.0685513 -0.0168638 0.000510465" quat="0.540064 0.528556 0.462198 0.46404" mass="0.127458" diaginertia="5.21681e-05 4.65029e-05 2.2273e-05"/>
                  <joint name="gripper_right_joint" pos="0 0 0" axis="0 -1 0" type="slide" range="0 0.04" actuatorfrcrange="-100 100"/>
                  <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.752941 0.752941 0.752941 1" mesh="R_finger"/>
