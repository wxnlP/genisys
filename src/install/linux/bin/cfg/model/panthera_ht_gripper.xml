    <light directional="true" pos="0 0 5" dir="0 0 -1"/>

    <body name="base_link" pos="0 0 0">
      <inertial pos="5.789e-05 -0.00015938 0.02298649" quat="0.711016188022 0.0188172827773 -0.702712108714 0.0172505798834" mass="0.62922454" diaginertia="0.000756520339294 0.000638826848938 0.000612962811768"/>
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.752941 0.752941 0.752941 1" mesh="base_link"/>
      <geom type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="base_link"/>
    </body>
    <body name="shoulder_link" pos="0 0 0.0584">
