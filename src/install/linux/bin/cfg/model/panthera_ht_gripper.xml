              <joint name="wrist2_joint" pos="0 0 0" axis="0 0 -1" range="-1.7 1.7" actuatorfrcrange="-10 10"/>
              <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.752941 0.752941 0.752941 1" mesh="link5"/>
              <geom type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="link5"/>
              <body name="wrist3_link" pos="0.02345 0 -0.039">
                <inertial pos="0.0365806 -4.4236e-05 -3.47544e-05" quat="0.512706 0.486973 -0.500963 0.499025" mass="0.106038" diaginertia="0.00177399 0.00116496 0.000713576"/>
                <joint name="wrist3_joint" pos="0 0 0" axis="1 0 0" range="-2.5 2.5" actuatorfrcrange="-10 10"/>
                <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.752941 0.752941 0.752941 1" mesh="link6"/>
