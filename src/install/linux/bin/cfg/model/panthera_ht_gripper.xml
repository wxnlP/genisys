    <jointpos name="jointpos_gripper_right" joint="gripper_right_joint" noise="0.0002"/>
    <jointvel name="jointvel_gripper_right" joint="gripper_right_joint" noise="0.002"/>
    <jointactuatorfrc name="jointactuatorfrc_gripper_right" joint="gripper_right_joint" noise="0.02"/>
  </sensor>
