<?xml version="1.0" encoding="utf-8"?>
<mujoco model="s6h4d_v1.0">
  <compiler eulerseq="XYZ" fitaabb="true" angle="radian" autolimits="true" />
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <visual>
    <global realtime="1"/>
    <quality shadowsize="16384" numslices="28" offsamples="4" />
    <headlight diffuse="1 1 1" specular="0.5 0.5 0.5" active="1" />
    <rgba fog="0 1 0 1" haze="1 0 0 1"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.2 0.3 0.4" rgb2="0 0 0" width="1000" height="1000" mark="random" random="0.001" markrgb="1 1 1"/>  
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="1000" height="1000"/>  
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <mesh name="arm_base_link" file="../meshes/s6h4d/arm_base_link.STL"/>
    <mesh name="a1_link" file="../meshes/s6h4d/a1_link.STL"/>
    <mesh name="a2_link" file="../meshes/s6h4d/a2_link.STL"/>
    <mesh name="a3_link" file="../meshes/s6h4d/a3_link.STL"/>
    <mesh name="a4_link" file="../meshes/s6h4d/a4_link.STL"/>
    <mesh name="a5_link" file="../meshes/s6h4d/a5_link.STL"/>
    <mesh name="a6_link" file="../meshes/s6h4d/a6_link.STL"/>

    <material name="visualgeom" rgba="0.86667 0.86667 0.8902 1"/>
    <material name="default_material" rgba="0.5 0.5 0.5 1"/>
    <material name="collision_material" rgba="1.0 0.28 0.1 0.9"/>
  </asset>

  <worldbody>
    <!-- 地板和头灯 -->
    <geom name="floor" pos="0 0 0" size="0 0 1" type="plane" material="groundplane"/>
    <light directional="true" diffuse=".8 .8 .8" specular=".2 .2 .2" pos="0 0 5" dir="0 0 -1"/>

    <!-- 机械臂底座 -->
    <body name="base_footprint" pos="0 0 0" euler="0 0 0">
      <geom name="base_footprint_visual" pos="0 0 0.005" euler="0 0 0" material="default_material" type="box" size="0.2 0.2 0.005"/>
      <!-- base link -->
      <body name="base_link" pos="0 0 0" euler="0 0 0">
        <geom name="base_link_visual" pos="0 0 0.01" euler="0 0 0" material="visualgeom" type="mesh" mesh="arm_base_link"/>
        <!-- shoulder link -->
        <body name="shoulder_link" pos="0 0 0" euler="0 0 1.5708">
          <joint name="shoulder_joint" type="hinge" axis="0 0 1" range="-2.4435 3.1416"/>
          <geom name="shoulder_link_visual" pos="0 0 0" euler="0 0 0" material="visualgeom" type="mesh" mesh="a1_link"/>
          <!-- upper arm link -->
          <body name="upper_arm_link" pos="-1.5657E-05 -0.051 0.219" euler="0 0 0">
            <joint name="upper_arm_joint" type="hinge" axis="1 0 0" range="-1.0472 1.7453"/>
            <geom name="upper_arm_link_visual" pos="0 0 0" euler="0 0 0" material="visualgeom" type="mesh" mesh="a2_link"/>
            <!-- elbow link -->
            <body name="elbow_link" pos="0 0 0.275" euler="0 0 1.5708">
              <joint name="elbow_joint" type="hinge" axis="0 1 0" ref="1.8326" range="0.5236 3.3161"/>
              <geom name="elbow_link_visual" pos="0 0 0" euler="0 0 0" material="visualgeom" type="mesh" mesh="a3_link"/>
              <!-- wrist1 link -->
              <body name="wrist1_link" pos="-0.0675 0 0.097" euler="-1.5708 0 -1.5708">
                <joint name="wrist1_joint" type="hinge" axis="0 0 1" range="-2.6180 2.6180"/>
                <geom name="wrist1_link_visual" pos="0 0 0" euler="0 0 0" material="visualgeom" type="mesh" mesh="a4_link"/>
                <!-- wrist2 link -->
                <body name="wrist2_link" pos="0 0 -0.209" euler="3.1416 0 -1.5708">
                  <joint name="wrist2_joint" type="hinge" axis="0 1 0" range="-0.5236 2.0944"/>
                  <geom name="wrist2_link_visual" pos="0 0 0" euler="0 0 0" material="visualgeom" type="mesh" mesh="a5_link"/>
                  <!-- wrist3 link (Need to change) -->
                  <body name="wrist3_link" pos="0 0 0.099" euler="0 1.5708 0">
                    <joint name="wrist3_joint" type="hinge" axis="1 0 0" range="-4.7124 4.7124"/>
                    <geom name="wrist3_link_visual" pos="0 0 0" euler="0 0 0" material="visualgeom" type="mesh" mesh="a6_link"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="shoulder_actuator" joint="shoulder_joint" ctrlrange="-2.4435 3.1416" kp="150" kv="10"/>
    <position name="upper_arm_actuator" joint="upper_arm_joint" ctrlrange="-1.0472 1.7453" kp="300" kv="30"/>
    <position name="elbow_actuator" joint="elbow_joint" ctrlrange="0.5236 3.3161" kp="150" kv="10"/>
    <position name="wrist1_actuator" joint="wrist1_joint" ctrlrange="-2.6180 2.6180" kp="50" kv="8"/>
    <position name="wrist2_actuator" joint="wrist2_joint" ctrlrange="-0.5236 2.0944" kp="10" kv="1"/>
    <position name="wrist3_actuator" joint="wrist3_joint" ctrlrange="-3.1416 3.1416" kp="1" kv="0.005"/>
  </actuator>

  <sensor>
    <!-- shoulder_joint -->
    <jointpos name="jointpos_shoulder" joint="shoulder_joint" noise="0.01"/>  
    <jointvel name="jointvel_shoulder" joint="shoulder_joint" noise="0.01"/>  
    <jointactuatorfrc name="jointactuatorfrc_shoulder" joint="shoulder_joint" noise="0.01"/> 

    <!-- upper_arm_joint -->
    <jointpos name="jointpos_upper_arm" joint="upper_arm_joint" noise="0.01"/>  
    <jointvel name="jointvel_upper_arm" joint="upper_arm_joint" noise="0.01"/>  
    <jointactuatorfrc name="jointactuatorfrc_upper_arm" joint="upper_arm_joint" noise="0.01"/> 

    <!-- elbow_joint -->
    <jointpos name="jointpos_elbow" joint="elbow_joint" noise="0.01"/>  
    <jointvel name="jointvel_elbow" joint="elbow_joint" noise="0.01"/>  
    <jointactuatorfrc name="jointactuatorfrc_elbow" joint="elbow_joint" noise="0.01"/> 

    <!-- wrist1_joint -->
    <jointpos name="jointpos_wrist1" joint="wrist1_joint" noise="0.01"/>  
    <jointvel name="jointvel_wrist1" joint="wrist1_joint" noise="0.01"/>  
    <jointactuatorfrc name="jointactuatorfrc_wrist1" joint="wrist1_joint" noise="0.01"/>  

    <!-- wrist2_joint -->
    <jointpos name="jointpos_wrist2" joint="wrist2_joint" noise="0.01"/>  
    <jointvel name="jointvel_wrist2" joint="wrist2_joint" noise="0.01"/>  
    <jointactuatorfrc name="jointactuatorfrc_wrist2" joint="wrist2_joint" noise="0.01"/> 

    <!-- wrist3_joint -->
    <jointpos name="jointpos_wrist3" joint="wrist3_joint" noise="0.01"/>  
    <jointvel name="jointvel_wrist3" joint="wrist3_joint" noise="0.01"/>  
    <jointactuatorfrc name="jointactuatorfrc_wrist3" joint="wrist3_joint" noise="0.01"/> 
  </sensor>
</mujoco>
